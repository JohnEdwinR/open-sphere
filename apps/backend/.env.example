# Copy to .env for local development. Matches infra/docker/docker-compose.yml's default credentials.
DATABASE_URL="postgresql://open_sphere:open_sphere_dev@localhost:5433/open_sphere?schema=public"
# 127.0.0.1, not "localhost": on Docker Desktop + WSL2, Node's IPv6-first
# resolution of "localhost" can route through a stale wslrelay.exe forward
# that TCP-connects successfully but never actually reaches the container —
# ioredis reports itself connected while Redis sees zero clients. Forcing
# IPv4 avoids the ambiguity entirely.
REDIS_URL="redis://127.0.0.1:6379"
