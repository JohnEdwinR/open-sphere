// Prisma schema translating 04_DATABASE/DatabaseDesign.md's ERD into a real,
// migratable schema. Model/field names are camelCase for the generated
// TS client; @@map/@map preserve the exact snake_case table/column names
// documented in the ERD, so the two stay traceable to each other.
//
// Deliberately NOT yet implemented here (documented in DatabaseDesign.md but
// requiring either operational tooling or product decisions this migration
// shouldn't presume):
//   - event_log range partitioning by occurred_at (§3.4) — deferred until
//     real write volume justifies the partition-maintenance automation
//     (pg_partman or a scheduled job); premature on a table with zero rows.
//   - v_creature_public_profile / v_leaderboard_snapshot (§4) — the
//     leaderboard view specifically depends on a ranking metric that hasn't
//     been decided by Product yet (FR-SOC-004 only says "server-authoritative
//     stats"); inventing one here would be a game-design decision disguised
//     as a migration.
// The death-memorial trigger (§3.2) IS implemented, as a follow-up raw-SQL
// migration — see prisma/migrations/*_add_death_memorial_trigger.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LifecycleState {
  alive
  dead
  despawned

  @@map("lifecycle_state")
}

enum GuildRole {
  member
  officer
  leader

  @@map("guild_role")
}

enum FriendshipStatus {
  pending
  accepted
  blocked

  @@map("friendship_status")
}

enum CurrencyType {
  coins
  seeds
  gems

  @@map("currency_type")
}

enum SubscriptionTier {
  monthly
  quarterly
  yearly

  @@map("subscription_tier")
}

enum SubscriptionStatus {
  active
  canceled
  expired
  grace_period

  @@map("subscription_status")
}

enum BillingPlatform {
  google_play
  apple_app_store

  @@map("billing_platform")
}

enum ChatScope {
  global
  guild
  dm

  @@map("chat_scope")
}

/// §3.1 — email uniqueness is enforced case-insensitively at the application
/// layer (always lowercased before write); a plain unique index is enough
/// here without taking a dependency on the citext extension for MVP.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String?   @map("password_hash")
  displayName  String    @map("display_name")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  isAdmin      Boolean   @default(false) @map("is_admin")
  isBanned     Boolean   @default(false) @map("is_banned")

  creatures            Creature[]
  friendshipsRequested Friendship[]    @relation("FriendshipRequester")
  friendshipsReceived  Friendship[]    @relation("FriendshipAddressee")
  guildMembership      GuildMember?
  guildsLed            Guild[]         @relation("GuildLeader")
  wallet               Wallet?
  inventoryItems       InventoryItem[]
  subscription         Subscription?
  chatMessages         ChatMessage[]
  adminAuditLogs       AdminAuditLog[]

  @@map("users")
}

/// §3.2 — jsonb columns are read/written wholesale by the simulation engine,
/// not queried column-by-column, so relational decomposition would add join
/// cost with no query benefit. ownerId is nullable: wild/unowned creatures
/// (Simulation & World Design §2.1) have no owner.
model Creature {
  id                String          @id @default(uuid()) @db.Uuid
  ownerId           String?         @map("owner_id") @db.Uuid
  owner             User?           @relation(fields: [ownerId], references: [id])
  species           String
  name              String?
  chunkId           Int             @map("chunk_id")
  chunk             WorldChunk      @relation(fields: [chunkId], references: [id])
  personalityTraits Json            @map("personality_traits")
  genetics          Json
  lifecycleState    LifecycleState  @default(alive) @map("lifecycle_state")
  bornAt            DateTime        @default(now()) @map("born_at") @db.Timestamptz
  diedAt            DateTime?       @map("died_at") @db.Timestamptz

  eventLogs EventLog[]
  cosmetics CreatureCosmetic[]

  @@index([ownerId])
  @@index([chunkId])
  // NOTE: DatabaseDesign.md §3.2 also calls for a partial index
  // `(lifecycle_state) WHERE lifecycle_state != 'dead'` for the hot
  // "living creatures" query path — Prisma's schema DSL has no partial-index
  // syntax, so this is added via the same raw-SQL follow-up migration as the
  // death-memorial trigger.
  @@map("creatures")
}

/// §3.3 — shardId is the future sharding partition key (§7); every creature
/// carries a non-optional chunkId so it's never treated as denormalizable.
model WorldChunk {
  id      Int    @id @default(autoincrement())
  x       Int
  y       Int
  biome   String
  shardId Int    @default(0) @map("shard_id")

  creatures Creature[]

  @@unique([x, y])
  @@index([shardId])
  @@map("world_chunks")
}

/// §3.4 — append-only; application code must never UPDATE or DELETE a row
/// here (only the retention job in §5 removes old partitions once
/// partitioning is added).
model EventLog {
  id         BigInt   @id @default(autoincrement())
  creatureId String   @map("creature_id") @db.Uuid
  creature   Creature @relation(fields: [creatureId], references: [id])
  eventType  String   @map("event_type")
  payload    Json
  tick       BigInt
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  @@index([creatureId, occurredAt(sort: Desc)])
  @@map("event_log")
}

model Guild {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  leaderId  String   @map("leader_id") @db.Uuid
  leader    User     @relation("GuildLeader", fields: [leaderId], references: [id])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  members GuildMember[]

  @@map("guilds")
}

/// §3.5 — userId is @unique (not just part of the composite PK) specifically
/// to enforce "a user may belong to at most one guild in MVP".
model GuildMember {
  guildId  String    @map("guild_id") @db.Uuid
  guild    Guild     @relation(fields: [guildId], references: [id])
  userId   String    @unique @map("user_id") @db.Uuid
  user     User      @relation(fields: [userId], references: [id])
  role     GuildRole @default(member)
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz

  @@id([guildId, userId])
  @@map("guild_members")
}

/// §3.6 — canonical direction (avoiding duplicate reverse rows) is enforced
/// at the application layer, not the schema, per the documented note.
model Friendship {
  requesterId String           @map("requester_id") @db.Uuid
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addresseeId String           @map("addressee_id") @db.Uuid
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id])
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@id([requesterId, addresseeId])
  @@map("friendships")
}

/// §3.7 — current-balance table. See Transaction for the append-only ledger
/// that must accompany every balance change (enforced at the application
/// layer via a single DB transaction, not by the schema).
model Wallet {
  userId String @id @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  coins  BigInt @default(0)
  seeds  BigInt @default(0)
  gems   BigInt @default(0)

  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id        BigInt       @id @default(autoincrement())
  walletId  String       @map("wallet_id") @db.Uuid
  wallet    Wallet       @relation(fields: [walletId], references: [userId])
  currency  CurrencyType
  amount    BigInt
  reason    String
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  @@index([walletId, createdAt(sort: Desc)])
  @@map("transactions")
}

model InventoryItem {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  itemType   String   @map("item_type")
  metadata   Json
  acquiredAt DateTime @default(now()) @map("acquired_at") @db.Timestamptz

  creatureCosmetics CreatureCosmetic[]

  @@index([userId])
  @@map("inventory_items")
}

/// Composite PK on (creatureId, slot) — not specified explicitly in the ERD,
/// but a creature can only wear one item per cosmetic slot ("skin", "hat",
/// ...) at a time, so this is the natural key rather than a surrogate id.
model CreatureCosmetic {
  creatureId      String        @map("creature_id") @db.Uuid
  creature        Creature      @relation(fields: [creatureId], references: [id])
  inventoryItemId String        @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  slot            String

  @@id([creatureId, slot])
  @@map("creature_cosmetics")
}

/// §3.8 — subscription status here is the entitlement source of truth,
/// reconciled via platform server-to-server webhooks (FR-PAY-003), never
/// client-reported state.
model Subscription {
  userId                 String             @id @map("user_id") @db.Uuid
  user                   User               @relation(fields: [userId], references: [id])
  tier                   SubscriptionTier
  platform               BillingPlatform
  platformSubscriptionId String             @map("platform_subscription_id")
  status                 SubscriptionStatus
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz

  @@unique([platform, platformSubscriptionId])
  @@map("subscriptions")
}

/// §3.9 — scopeId is polymorphic (a guild id, a DM-conversation id, or null
/// for global chat) depending on `scope`, so it deliberately has no Prisma
/// relation()/FK — a single foreign key can't target three different
/// meanings. Enforcement of scopeId validity is an application-layer concern.
model ChatMessage {
  id       BigInt    @id @default(autoincrement())
  senderId String    @map("sender_id") @db.Uuid
  sender   User      @relation(fields: [senderId], references: [id])
  scope    ChatScope
  scopeId  String?   @map("scope_id") @db.Uuid
  body     String
  sentAt   DateTime  @default(now()) @map("sent_at") @db.Timestamptz

  @@index([scope, scopeId, sentAt])
  @@map("chat_messages")
}

/// §3.10 — append-only; no update/delete path is ever exposed at the
/// application layer (NFR-SEC-004 / FR-ADM-003).
model AdminAuditLog {
  id        BigInt   @id @default(autoincrement())
  adminId   String   @map("admin_id") @db.Uuid
  admin     User     @relation(fields: [adminId], references: [id])
  action    String
  context   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("admin_audit_log")
}
